**/*.pyc
**/*.pyo
**/*.pyd
venv/
apps/backend/venv/
.pytest_cache/
apps/backend/.pytest_cache/

# Node / Frontend Build Artifacts
node_modules/
apps/frontend/node_modules/
npm-debug.log
apps/frontend/.next/
apps/frontend/.next-test/
apps/frontend/.swc/
apps/frontend/.turbo/
.turbo/

# Testing Suites & Coverage
apps/frontend/tests/
apps/frontend/playwright-report/
apps/frontend/test-results/
coverage/
