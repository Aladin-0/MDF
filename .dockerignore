apps/frontend/jest.config.js
apps/frontend/jest.setup.js

# Documentation
docs/
apps/backend/docs/
**/*.md
!README.deployment.md

# Logs & Debug Scripts
logs/
apps/backend/logs/
*.log
*.txt
scratch/
fix_*.py
patch_*.py
test_*.py
debug_*.py
check_*.py
